{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BRK deployed files manifest",
  "description": "Repo files that actually start BRK; tests/rpc_argv_gate.py checks only these.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "files"],
  "properties": {
    "version": {"const": 1},
    "files": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
