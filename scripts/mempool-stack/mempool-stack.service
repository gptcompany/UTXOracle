[Unit]
Description=Self-hosted mempool.space stack with electrs
Requires=docker.service bitcoind.service
After=docker.service bitcoind.service network-online.target
Wants=network-online.target
RequiresMountsFor=/data/4TB /data/2TB /data/cold/12TB

[Service]
Type=oneshot
WorkingDirectory=/data/4TB/prod/apps/mempool-stack
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
RemainAfterExit=yes
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
