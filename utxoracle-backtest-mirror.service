[Unit]
Description=UTXOracle backtest_whale_signals DuckDB -> QuestDB mirror (spec-061 T026c)
After=network-online.target questdb.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/media/sam/1TB/UTXOracle
Environment="PATH=/home/sam/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment=UTXORACLE_DB_PATH=/media/sam/1TB/UTXOracle/data/utxoracle.duckdb
ExecStart=/usr/bin/env uv run python -m scripts.metrics.mirror_backtest_whale_signals

[Install]
WantedBy=multi-user.target
