[Unit]
Description=UTXOracle QuestDB block_heights catch-up via Bitcoin Core RPC (spec-061 Phase 1.5-v2)
After=questdb.service
Wants=questdb.service

[Service]
Type=oneshot
User=sam
Group=sam
WorkingDirectory=/media/sam/1TB/UTXOracle
Environment=PYTHONUNBUFFERED=1
Environment="PATH=/home/sam/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-/media/sam/1TB/UTXOracle/.env
ExecStart=/usr/bin/env uv run python -m scripts.bootstrap.build_block_heights_questdb
StandardOutput=journal
StandardError=journal
SyslogIdentifier=utxoracle-block-heights-catchup

[Install]
WantedBy=multi-user.target
