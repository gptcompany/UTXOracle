[Unit]
Description=UTXOracle daily metrics aggregator (spec-061 T024)
After=network-online.target questdb.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/media/sam/1TB/UTXOracle
Environment=UTXORACLE_DB_PATH=/media/sam/1TB/UTXOracle/data/utxoracle.duckdb
ExecStart=/usr/bin/env uv run python -m scripts.metrics.calculate_daily_metrics

[Install]
WantedBy=multi-user.target
