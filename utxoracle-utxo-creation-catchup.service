# UTXOracle UTXO creation catch-up supervisor.
#
# This wraps scripts/bootstrap/utxo_lifecycle_supervisor.sh creation.
# The supervisor retries the RPC catch-up path and self-exits with status
# 0 once its log shows "Already at tip" or "catch-up complete"; systemd
# records the clean terminal state and does not restart it.

[Unit]
Description=UTXOracle UTXO creation catch-up supervisor (spec-061 Phase 1)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=sam
Group=sam
WorkingDirectory=/media/sam/1TB/UTXOracle
Environment=PYTHONUNBUFFERED=1
Environment="PATH=/home/sam/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-/media/sam/1TB/UTXOracle/.env
ExecStart=/usr/bin/env bash /media/sam/1TB/UTXOracle/scripts/bootstrap/utxo_lifecycle_supervisor.sh creation
ExecStopPost=/bin/sh -c 'if [ "$SERVICE_RESULT" != "success" ] && [ -n "$DISCORD_WEBHOOK_URL" ]; then payload=$(/usr/bin/printf "{\"content\":\"%%s failed: result=%%s exit=%%s/%%s\"}" "%n" "$SERVICE_RESULT" "$EXIT_CODE" "$EXIT_STATUS"); /usr/bin/curl -fsS -H "Content-Type: application/json" --data-raw "$payload" "$DISCORD_WEBHOOK_URL" || true; fi'
Restart=on-failure
RestartSec=60s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=utxoracle-utxo-creation-catchup

[Install]
WantedBy=multi-user.target
